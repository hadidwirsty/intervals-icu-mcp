# Wajib: API key dari intervals.icu -> Settings > Developer Settings
INTERVALS_API_KEY=

# Opsional: athlete ID default (contoh: i123456 atau 123456).
# Kalau kosong, wajib dikirim sebagai argumen `athleteId` di tiap tool call.
INTERVALS_ATHLETE_ID=

# Opsional: override base URL API (jarang perlu diubah)
INTERVALS_API_BASE_URL=https://intervals.icu/api/v1
